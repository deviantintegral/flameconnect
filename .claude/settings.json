{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/setup.sh\"",
            "timeout": 120,
            "statusMessage": "Syncing dependencies and installing pre-commit hooks..."
          }
        ]
      }
    ]
  }
}
